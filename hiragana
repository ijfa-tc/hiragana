function pt(e){const m=pad.getScreenCTM().inverse(),p=pad.createSVGPoint();p.x=e.clientX;p.y=e.clientY;const q=p.matrixTransform(m);return[q.x,q.y];}
pad.addEventListener("pointerdown",e=>{if(busy||k>=tmp.length)return;e.preventDefault();drawing=true;pad.setPointerCapture(e.pointerId);pts=[pt(e)];$("ink").setAttribute("d","");});
pad.addEventListener("pointermove",e=>{if(!drawing)return;pts.push(pt(e));$("ink").setAttribute("d","M"+pts.map(p=>p[0].toFixed(1)+","+p[1].toFixed(1)).join("L"));});
function end(){if(!drawing)return;drawing=false;const u=rs(pts);$("ink").setAttribute("d","");if(!u)return;
const n=tmp.length,dk=dist(u,tmp[k]);
if(dk<TH&&ends(u,tmp[k])){mk($("done"),DATA[cur].s[k]);k++;updCnt();if(k>=n)finish();else setMsg((k+1)+"画目をなぞってください","Telusuri goresan ke-"+(k+1),miss?"":"ok");return;}
miss++;busy=true;
if(dist(u,tmp[k].slice().reverse())<TH){setMsg("向きが逆です。オレンジの向きで書きましょう","Arahnya terbalik. Ikuti arah oranye.","ng");hint(k);return;}
for(let j=k+1;j<n;j++){if(dist(u,tmp[j])<TH){setMsg("書き順がちがいます。先に"+(k+1)+"画目です","Urutan salah. Goresan ke-"+(k+1)+" dulu.","ng");hint(k);return;}}
setMsg("もう一度。オレンジの線をよく見てなぞりましょう","Coba lagi. Perhatikan garis oranye.","ng");hint(k);}
pad.addEventListener("pointerup",end);pad.addEventListener("pointercancel",end);
$("demo").onclick=()=>{reset();busy=true;const s=DATA[cur].s;let t=100;$("done").innerHTML="";s.forEach(d=>{const L=(()=>{const p=mk($("hint"),d),l=p.getTotalLength();p.remove();return l})(),dur=Math.max(.5,L/55);anim($("hint"),d,dur,t);t+=dur*1000+350;});setMsg("お手本を見てください","Perhatikan contohnya.");timers.push(setTimeout(()=>{$("hint").innerHTML="";busy=false;k=0;updCnt();setMsg("1画目をなぞってください","Telusuri goresan ke-1");},t+400));};
$("retry").onclick=reset;
$("next").onclick=()=>{const i=ORDER.indexOf(cur);open(ORDER[(i+1)%ORDER.length]);};
$("back").onclick=()=>{clearT();$("practice").hidden=true;$("home").hidden=false;buildTable();};
buildTable();
</script>
